{
  "name": "claw-dashboard",
  "version": "2.1.1",
  "description": "A beautiful console dashboard for monitoring OpenClaw instances — inspired by htop/btop/mactop",
  "main": "index.js",
  "exports": {
    ".": {
      "import": "./index.js"
    },
    "./widgets": {
      "import": "./src/widgets/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "clawdash": "./index.js"
  },
  "man": [
    "./man/clawdash.1"
  ],
  "files": [
    "index.js",
    "src/**/*.js",
    "src/**/*.ts",
    "!src/database.js",
    "man/clawdash.1",
    "docs/*.md",
    "schemas/*.json",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "package.json"
  ],
  "type": "module",
  "scripts": {
    "start": "node index.js",
    "dev": "node index.js --debug",
    "test": "node --experimental-vm-modules node_modules/.bin/jest",
    "test:coverage": "c8 --reporter=text --reporter=html --reporter=lcov npm test",
    "test:coverage:check": "c8 --check-coverage npm test",
    "coverage:report": "c8 report",
    "coverage:clean": "rm -rf coverage",
    "build": "node esbuild.config.js",
    "build:dev": "node esbuild.config.js --dev",
    "lint": "eslint src/ --ignore-pattern 'src/workers/**'",
    "release": "node scripts/release.js",
    "release:sign": "node scripts/release.js --sign",
    "release:github": "node scripts/release.js --github --sign",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spleck/claw-dashboard.git"
  },
  "bugs": {
    "url": "https://github.com/spleck/claw-dashboard/issues"
  },
  "homepage": "https://github.com/spleck/claw-dashboard#readme",
  "keywords": [
    "openclaw",
    "dashboard",
    "monitor",
    "tui",
    "terminal",
    "console"
  ],
  "author": "Kevin Smith",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@pm2/blessed": "^0.1.81",
    "blessed": "npm:@pm2/blessed@^0.1.81",
    "chalk": "^5.3.0",
    "systeminformation": "^5.21.22"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "c8": "^12.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.0.2",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "lint-staged": "^17.2.0"
  },
  "lint-staged": {
    "src/**/*.{js,mjs,cjs}": [
      "eslint --fix --ignore-pattern 'src/workers/**'",
      "node --experimental-vm-modules node_modules/.bin/jest --bail --findRelatedTests"
    ]
  },
  "overrides": {
    "xml2js": "^0.6.2",
    "form-data": "^4.0.0",
    "qs": "^6.14.1",
    "tough-cookie": "^5.0.0",
    "brace-expansion": "^5.0.8"
  }
}
